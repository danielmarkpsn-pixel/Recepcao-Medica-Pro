{
  "name": "controle-de-consulta",
  "version": "1.0.0",
  "description": "Sistema local para cadastro de pacientes, agenda e controle de consultas",
  "main": "src/main.js",
  "author": "Controle de Consulta",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.controledeconsulta",
    "productName": "Controle de Consulta",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Controle-de-Consulta-Setup-${version}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
